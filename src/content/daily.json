[
  { "id": "D_TERM_GROUP_PROJECT", "slot": "TERM", "text": "小组作业四个人，有一个人从头到尾只回了一个“收到”。", "when": {}, "weight": 2 },
  { "id": "D_TERM_OFFICE_HOUR", "slot": "TERM", "text": "你第一次去教授的 office hour，发现屋里只有你一个人。", "when": {}, "weight": 2 },
  { "id": "D_TERM_DINING_PIZZA", "slot": "TERM", "text": "食堂的披萨连吃三周后，你开始想念家门口的煎饼果子。", "when": {}, "weight": 2 },
  { "id": "D_TERM_NAME_CALL", "slot": "TERM", "text": "点名时教授把你的名字念出了三种读法，你都答应了。", "when": {}, "weight": 2 },
  { "id": "D_TERM_ENGLISH_NAME", "slot": "TERM", "text": "你给自己起了个英文名，结果总忘了别人是在叫你。", "when": {}, "weight": 2 },
  { "id": "D_TERM_HOW_ARE_YOU", "slot": "TERM", "text": "收银员问你今天过得怎么样，你认真回答了三分钟。", "when": {}, "weight": 2 },
  { "id": "D_TERM_TIP", "slot": "TERM", "text": "第一次在餐厅算小费，你掏出计算器算到了小数点后两位。", "when": {}, "weight": 2 },
  { "id": "D_TERM_DORM_HOTPOT", "slot": "TERM", "text": "宿舍偷偷煮火锅，烟雾报警器比你们还兴奋。", "when": {}, "weight": 2 },
  { "id": "D_TERM_LAUNDRY", "slot": "TERM", "text": "洗衣房排队排到半夜，你的衣服被人拿出来叠好了。", "when": {}, "weight": 1 },
  { "id": "D_TERM_SQUIRREL", "slot": "TERM", "text": "校园里的松鼠比你还胖，见了人也不跑。", "when": {}, "weight": 2 },
  { "id": "D_TERM_GROUP_CHAT", "slot": "TERM", "text": "中国学生群一天几百条消息，一半是转让二手家具。", "when": {}, "weight": 2 },
  { "id": "D_TERM_CURVE", "slot": "TERM", "text": "期中考试全班平均分五十几，教授说会调分，大家松了口气。", "when": {}, "weight": 2 },
  { "id": "D_TERM_FOOD_SHOW", "slot": "TERM", "text": "每周日晚上和家里视频，固定节目是展示今天吃了什么。", "when": {}, "weight": 1 },
  { "id": "D_TERM_TIME_ZONE", "slot": "TERM", "text": "隔着十几个小时的时差，家里的早安是你的晚安。", "when": {}, "weight": 2 },
  { "id": "D_TERM_COSTCO", "slot": "TERM", "text": "和室友拼车去 Costco，买回的纸巾够用到毕业。", "when": {}, "weight": 2 },
  { "id": "D_TERM_ASIAN_MARKET", "slot": "TERM", "text": "坐一个小时公交去亚洲超市，背回来半箱方便面。", "when": {}, "weight": 2 },
  { "id": "D_TERM_PANDA", "slot": "TERM", "text": "你在熊猫快餐点了左宗棠鸡，觉得自己背叛了家乡。", "when": {}, "weight": 2 },
  { "id": "D_TERM_SKIPPED", "slot": "TERM", "text": "你翘了一节八点的课，结果那节课讲了期末考什么。", "when": {}, "weight": 2 },
  { "id": "D_TERM_SYLLABUS", "slot": "TERM", "text": "开学第一周，教授把课程大纲念完就下课了。", "when": {}, "weight": 1 },
  { "id": "D_TERM_I_AGREE", "slot": "TERM", "text": "课堂讨论算分，你憋了一节课，只说出一句“I agree”。", "when": {}, "weight": 2 },
  { "id": "D_TERM_EXCHANGE_RATE", "slot": "TERM", "text": "你在超市把价格乘以汇率，最后什么都没买。", "when": {}, "weight": 2 },
  { "id": "D_TERM_MILK_TEA_LINE", "slot": "TERM", "text": "学校旁边开了家奶茶店，中国学生排的队绕了一个街区。", "when": {}, "weight": 1 },
  { "id": "D_TERM_UMBRELLA", "slot": "TERM", "text": "本地同学下雨从不打伞，你也试了一次，感冒了。", "when": {}, "weight": 2 },
  { "id": "D_TERM_SHORTS", "slot": "TERM", "text": "零下的天气，隔壁同学穿着短裤去上课。", "when": {}, "weight": 2 },
  { "id": "D_TERM_HOT_WATER", "slot": "TERM", "text": "你跑遍整栋楼找热水，最后买了个电热水壶。", "when": {}, "weight": 2 },
  { "id": "D_TERM_ICE", "slot": "TERM", "text": "餐厅的水杯里永远是冰块，你学会了说“no ice”。", "when": {}, "weight": 1 },
  { "id": "D_TERM_TOMATO_EGG", "slot": "TERM", "text": "你在公共厨房炒了个番茄炒蛋，围观的同学要了菜谱。", "when": {}, "weight": 2 },
  { "id": "D_TERM_FREE_PIZZA", "slot": "TERM", "text": "讲座海报上写着“免费披萨”，你去了，没听懂，但吃饱了。", "when": {}, "weight": 2 },
  { "id": "D_TERM_GYM", "slot": "TERM", "text": "你办了健身房的卡，去了两次，都是为了洗澡。", "when": {}, "weight": 2 },
  { "id": "D_TERM_BIRTHDAY", "slot": "TERM", "text": "生日那天室友买了个蛋糕，大家用英文唱完又用中文唱了一遍。", "when": {}, "weight": 1 },
  { "id": "D_TERM_TEXTBOOK", "slot": "TERM", "text": "课本两百多刀，你在图书馆借到了唯一一本，限借两小时。", "when": {}, "weight": 1 },
  { "id": "D_TERM_ELEVATOR", "slot": "TERM", "text": "电梯里遇到教授，你们聊了二十秒天气，像过了一年。", "when": {}, "weight": 2 },
  { "id": "D_TERM_PACKAGE", "slot": "TERM", "text": "家里寄的快递在海关躺了一个月，到手时辣条都压扁了。", "when": {}, "weight": 1 },
  { "id": "D_TERM_DELIVERY", "slot": "TERM", "text": "外卖员把餐放在了隔壁楼门口，你穿着拖鞋找了二十分钟。", "when": {}, "weight": 1 },
  { "id": "D_TERM_LIBRARY_COAT", "slot": "TERM", "text": "你在图书馆的沙发上睡着了，醒来身上多了一件陌生人的外套。", "when": {}, "weight": 1 },
  { "id": "D_TERM_SICHUAN", "slot": "TERM", "text": "城里唯一的川菜馆，老板已经记住了你的点单。", "when": {}, "weight": 2 },
  { "id": "D_TERM_LOCKOUT", "slot": "TERM", "text": "你被锁在宿舍门外，穿着睡衣等了四十分钟的宿管。", "when": {}, "weight": 1 },
  { "id": "D_TERM_SCAM_CALL", "slot": "TERM", "text": "你接到一个自称大使馆的电话，挂掉后在群里提醒了所有人。", "when": {}, "weight": 1 },
  { "id": "D_TERM_EMAIL_DRAFT", "slot": "TERM", "text": "给教授的邮件写了改、改了写，最后只发出去三行。", "when": {}, "weight": 2 },
  { "id": "D_TERM_DEADLINE_2359", "slot": "TERM", "text": "作业晚上十一点五十九分截止，你在五十八分交上了。", "when": {}, "weight": 2 },
  { "id": "D_TERM_SELF_CHECKOUT", "slot": "TERM", "text": "自助结账机第五次喊“请把商品放进袋子”，你放弃了。", "when": {}, "weight": 1 },
  { "id": "D_TERM_CHINESE_NAME", "slot": "TERM", "text": "本地同学问你中文名怎么写，你写完对方说像一幅画。", "when": {}, "weight": 1 },

  { "id": "D_TERM_LIBRARY", "slot": "TERM", "text": "你在图书馆三楼有了一个固定座位，没人敢坐。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_ALL_NIGHTER", "slot": "TERM", "text": "考前通宵，你和图书馆的保安成了点头之交。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_OFFICE_HOUR_REGULAR", "slot": "TERM", "text": "你每周都去 office hour，助教看见你就把椅子拉开了。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_STUDY_GROUP", "slot": "TERM", "text": "学习小组从讨论作业开始，从点外卖结束。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_COFFEE", "slot": "TERM", "text": "这学期你喝掉的咖啡，比高中三年加起来还多。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_OBVIOUSLY", "slot": "TERM", "text": "一道作业题卡了你三天，答案只写了“显然可得”。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_OUTLETS", "slot": "TERM", "text": "你把图书馆每一层的插座位置都背下来了。", "when": { "focusAny": ["STUDY"] }, "weight": 3 },
  { "id": "D_TERM_CAREER_FAIR", "slot": "TERM", "text": "招聘会上你领了十几件周边，简历一份也没递出去。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_REJECTIONS", "slot": "TERM", "text": "网申投了一百多份，收到的回复都以“很遗憾”开头。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_LEETCODE", "slot": "TERM", "text": "你刷题刷到做梦都在想边界条件。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_COFFEE_CHAT", "slot": "TERM", "text": "你约了一个校友喝咖啡，对方全程在讲自己当年多惨。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_RESUME_V12", "slot": "TERM", "text": "简历改到第十二版，你已经认不出上面那个人是谁。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_SUIT_TOP", "slot": "TERM", "text": "凌晨三点和国内的公司视频面试，你只穿了上半身的正装。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_ALEX", "slot": "TERM", "text": "社交活动上你记住了五个人的名字，全都叫 Alex。", "when": { "focusAny": ["CAREER"] }, "weight": 3 },
  { "id": "D_TERM_FIRST_PARTY", "slot": "TERM", "text": "你去了人生第一场派对，在厨房和同样谁也不认识的同学聊了一晚。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_CLUB_TREASURER", "slot": "TERM", "text": "你在社团里被选成了财务，因为只有你会做表格。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_HOTPOT_DATE", "slot": "TERM", "text": "你约了心动的同学去吃火锅，聊到店家打烊。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_MIXER", "slot": "TERM", "text": "学生会办联谊活动，你负责搬桌子，顺便认识了半个年级。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_INTRAMURAL", "slot": "TERM", "text": "你加入了院系的业余篮球队，主要职责是喊加油。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_KARAOKE", "slot": "TERM", "text": "周五晚上一群人去唱 K，你一首老歌唱哭了半个包厢。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_MURDER_MYSTERY", "slot": "TERM", "text": "剧本杀组了一整晚，你演凶手，第一轮就被全票指认。", "when": { "focusAny": ["CAMPUS"] }, "weight": 3 },
  { "id": "D_TERM_TRAY", "slot": "TERM", "text": "你在食堂端盘子，学会了一只手托三个餐盘。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_CAMPUS_DELIVERY", "slot": "TERM", "text": "你在校内送餐，摸清了每栋楼哪部电梯最快。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_FRONT_DESK", "slot": "TERM", "text": "图书馆前台值夜班，你一晚上回答了二十次厕所在哪。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_GRADER", "slot": "TERM", "text": "你帮课程批作业，发现全班错的都是同一道题。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_PAYCHECK", "slot": "TERM", "text": "第一张工资单到手，你把时薪换算成人民币，又换算回来。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_LATTE_ART", "slot": "TERM", "text": "你在校园咖啡店打工，拉花拉成了一颗土豆。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_SHIFT_TETRIS", "slot": "TERM", "text": "打工排班表和课表叠在一起，像一局俄罗斯方块。", "when": { "focusAny": ["WORK"] }, "weight": 3 },
  { "id": "D_TERM_SLEEP_IN", "slot": "TERM", "text": "你连睡了十二个小时，醒来发现已经是第二天下午。", "when": { "focusAny": ["REST"] }, "weight": 3 },
  { "id": "D_TERM_BINGE", "slot": "TERM", "text": "你一周追完了一部八十集的剧，感觉自己也演了一遍。", "when": { "focusAny": ["REST"] }, "weight": 3 },
  { "id": "D_TERM_GAMING", "slot": "TERM", "text": "你和国内的朋友开黑到天亮，延迟三百，快乐满格。", "when": { "focusAny": ["REST"] }, "weight": 3 },
  { "id": "D_TERM_BRAISED_PORK", "slot": "TERM", "text": "你学会了做红烧肉，第一次成功时拍了九张照片。", "when": { "focusAny": ["REST"] }, "weight": 3 },
  { "id": "D_TERM_WOODS", "slot": "TERM", "text": "你绕着校园散步，第一次发现学校后面有一片树林。", "when": { "focusAny": ["REST"] }, "weight": 3 },
  { "id": "D_TERM_LYING_FLAT", "slot": "TERM", "text": "这学期你把“躺平”从口号变成了日程。", "when": { "focusAny": ["REST"] }, "weight": 3 },

  { "id": "D_TERM_EMO_PLAYLIST", "slot": "TERM", "text": "凌晨三点你还醒着，听完了整张歌单，又从头放了一遍。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_TERM_EMO_POST", "slot": "TERM", "text": "你发了一条仅自己可见的朋友圈，写了很长，第二天删了。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_TERM_EMO_COUNSELING", "slot": "TERM", "text": "你预约了学校的心理咨询，排到的时间在三周以后。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_TERM_EMO_CEILING", "slot": "TERM", "text": "你盯着天花板躺了一个下午，作业也盯着你。", "when": { "statMax": { "wellbeing": 30 } }, "weight": 4 },
  { "id": "D_TERM_EMO_FINE", "slot": "TERM", "text": "视频里你说一切都好，挂了电话在床上坐了很久。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_TERM_GLOW", "slot": "TERM", "text": "你最近气色很好，室友怀疑你偷偷谈了恋爱。", "when": { "statMin": { "wellbeing": 85 } }, "weight": 4 },
  { "id": "D_TERM_NOODLE_RANKING", "slot": "TERM", "text": "这个月你吃遍了超市里所有口味的泡面，给它们排了名。", "when": { "statMax": { "money": 15 } }, "weight": 4 },
  { "id": "D_TERM_FREE_FOOD_SHEET", "slot": "TERM", "text": "你建了一个表格，记录全校哪些活动管饭。", "when": { "statMax": { "money": 15 } }, "weight": 4 },
  { "id": "D_TERM_BALANCE", "slot": "TERM", "text": "你登录网银看了一眼余额，又默默退出了。", "when": { "statMax": { "money": 20 } }, "weight": 4 },
  { "id": "D_TERM_STRATEGIC_RESERVE", "slot": "TERM", "text": "冰箱里只剩一瓶老干妈和半袋米，你称之为战略储备。", "when": { "statMax": { "money": 10 } }, "weight": 4 },
  { "id": "D_TERM_RICH_TAKEOUT", "slot": "TERM", "text": "你点外卖从来不看价格，室友看你的眼神有点复杂。", "when": { "statMin": { "money": 75 } }, "weight": 4 },
  { "id": "D_TERM_RICH_TREAT", "slot": "TERM", "text": "你请全组同学吃了顿日料，小组作业突然有人抢着做了。", "when": { "statMin": { "money": 75 } }, "weight": 4 },
  { "id": "D_TERM_XUESHEN", "slot": "TERM", "text": "同学开始叫你“学神”，找你借笔记的人排到了下周。", "when": { "statMin": { "academics": 75 } }, "weight": 4 },
  { "id": "D_TERM_FRONT_ROW", "slot": "TERM", "text": "教授在课上说“这题可以问问坐第一排那位”，说的是你。", "when": { "statMin": { "academics": 85 } }, "weight": 4 },
  { "id": "D_TERM_LOST_IN_CLASS", "slot": "TERM", "text": "这门课你从第三周开始就没听懂过，但笔记记得很工整。", "when": { "statMax": { "academics": 25 } }, "weight": 4 },
  { "id": "D_TERM_HEADHUNTER", "slot": "TERM", "text": "开始有猎头在网上给你发消息，虽然都把你的名字拼错了。", "when": { "statMin": { "career": 70 } }, "weight": 4 },
  { "id": "D_TERM_COUNT_STUDY", "slot": "TERM", "text": "图书馆的保安换了三任，你还在。", "when": { "countMin": { "STUDY": 4 } }, "weight": 5 },
  { "id": "D_TERM_COUNT_WORK", "slot": "TERM", "text": "你在食堂干得太久，新来的员工以为你是主管。", "when": { "countMin": { "WORK": 4 } }, "weight": 5 },
  { "id": "D_TERM_COUNT_REST", "slot": "TERM", "text": "你休息得太有规律，朋友给你起了个外号叫“躺神”。", "when": { "countMin": { "REST": 3 } }, "weight": 5 },

  { "id": "D_TERM_FRESHMAN_LOST", "slot": "TERM", "text": "开学一个月，你还是会在同一栋教学楼里迷路。", "when": { "stage": "UG", "termMax": 2 }, "weight": 4 },
  { "id": "D_TERM_FRESHMAN_RUN", "slot": "TERM", "text": "大一的你立志每天跑步，坚持了整整四天。", "when": { "stage": "UG", "termMax": 2 }, "weight": 4 },
  { "id": "D_TERM_FRESHMAN_LANYARD", "slot": "TERM", "text": "你把学生卡挂在脖子上走遍了全校，一看就是新生。", "when": { "stage": "UG", "termMax": 2 }, "weight": 4 },
  { "id": "D_TERM_JUNIOR_INTERNS", "slot": "TERM", "text": "大三了，群里开始有人晒实习，你默默关掉了消息提醒。", "when": { "stage": "UG", "termMin": 5, "termMax": 6 }, "weight": 4 },
  { "id": "D_TERM_SENIOR_SCHEDULE", "slot": "TERM", "text": "大四的课表空了一半，你开始认真思考人生。", "when": { "stage": "UG", "termMin": 7 }, "weight": 4 },
  { "id": "D_TERM_WRONG_DIRECTIONS", "slot": "TERM", "text": "新生拿着地图问路，你热心指了一条，回来才发现指错了。", "when": { "stage": "UG", "termMin": 3 }, "weight": 2 },
  { "id": "D_TERM_MS_CHINESE", "slot": "TERM", "text": "硕士班上一半是中国同学，小组讨论自动切换成了中文。", "when": { "stage": "MS" }, "weight": 4 },
  { "id": "D_TERM_MS_WEEKS", "slot": "TERM", "text": "硕士的日子按周计算：作业、求职、作业、求职。", "when": { "stage": "MS" }, "weight": 4 },
  { "id": "D_TERM_MS_YOUNG_TA", "slot": "TERM", "text": "助教看起来比你还小，你决定不去想这件事。", "when": { "stage": "MS" }, "weight": 4 },
  { "id": "D_TERM_MS_CAPSTONE", "slot": "TERM", "text": "毕业项目组会开了两小时，结论是下次再开一次。", "when": { "stage": "MS", "termMin": 2 }, "weight": 4 },

  { "id": "D_TERM_CA_SUN", "slot": "TERM", "text": "加州的阳光好得过分，你在草坪上读书读到睡着。", "when": { "schoolStates": ["CA"] }, "weight": 5 },
  { "id": "D_TERM_CA_TRADER_JOES", "slot": "TERM", "text": "你在 Trader Joe's 买了一堆网红零食，吃完发现都是一个味。", "when": { "schoolStates": ["CA"] }, "weight": 5 },
  { "id": "D_TERM_NY_SUBWAY", "slot": "TERM", "text": "第一次坐纽约地铁，你在换乘通道里绕了半小时，出来是另一条街。", "when": { "schoolStates": ["NY", "NJ", "CT"] }, "weight": 5 },
  { "id": "D_TERM_NY_CENTRAL_PARK", "slot": "TERM", "text": "周末去曼哈顿，你在中央公园坐了一下午，假装自己是电影主角。", "when": { "schoolStates": ["NY", "NJ", "CT"] }, "weight": 5 },
  { "id": "D_TERM_NEW_ENGLAND_LOBSTER", "slot": "TERM", "text": "你咬了一口贵得离谱的龙虾卷，决定这个月剩下的日子吃泡面。", "when": { "schoolStates": ["MA", "ME", "RI", "NH", "CT"] }, "weight": 5 },
  { "id": "D_TERM_WA_GREY", "slot": "TERM", "text": "你在华盛顿州学会了分辨十几种灰色的天空。", "when": { "schoolStates": ["WA"] }, "weight": 5 },
  { "id": "D_TERM_DC_MUSEUMS", "slot": "TERM", "text": "周末去了国家广场，博物馆全都免费，你逛到腿软。", "when": { "schoolStates": ["DC", "VA", "MD"] }, "weight": 5 },
  { "id": "D_TERM_SOUTH_SWEET_TEA", "slot": "TERM", "text": "南方的冰茶甜得像糖水，你喝了一口就去找白开水。", "when": { "schoolStates": ["GA", "NC", "SC", "TN", "AL", "KY", "LA", "MS", "AR"] }, "weight": 5 },
  { "id": "D_TERM_FL_AC", "slot": "TERM", "text": "教室的冷气开得太足，你在佛罗里达随身带了件外套。", "when": { "schoolStates": ["FL"] }, "weight": 5 },
  { "id": "D_TERM_TX_BIG", "slot": "TERM", "text": "德州的一切都很大，你点的中杯饮料能喝一整天。", "when": { "schoolStates": ["TX"] }, "weight": 5 },
  { "id": "D_TERM_S_INTROS", "slot": "TERM", "text": "同学们自我介绍，一个比一个吓人：竞赛金牌、创业公司、出过书。", "when": { "schoolTiers": ["S"] }, "weight": 4 },
  { "id": "D_TERM_S_NOBEL", "slot": "TERM", "text": "校园导览说这里出过好几位诺奖得主，你在同一间教室里睡着了。", "when": { "schoolTiers": ["S"] }, "weight": 4 },
  { "id": "D_TERM_TOP_HANDS", "slot": "TERM", "text": "你在课上发言前打了三遍腹稿，旁边的同学已经举手第四次了。", "when": { "schoolTiers": ["S", "A"] }, "weight": 4 },
  { "id": "D_TERM_HIGH_BAG", "slot": "TERM", "text": "你随手背的包被同学认出了牌子，你说是打折买的，没人信。", "when": { "economies": ["HIGH"] }, "weight": 4 },
  { "id": "D_TERM_HIGH_POOL", "slot": "TERM", "text": "你住的公寓有健身房和泳池，同学来你家开组会都不想走。", "when": { "economies": ["HIGH"] }, "weight": 4 },
  { "id": "D_TERM_LOW_LEDGER", "slot": "TERM", "text": "你把每一笔开销都记在本子上，连一包纸巾也不放过。", "when": { "economies": ["LOW"] }, "weight": 4 },
  { "id": "D_TERM_LOW_SOFA", "slot": "TERM", "text": "二手群里有人送旧沙发，你和室友抬着它走了两条街。", "when": { "economies": ["LOW"] }, "weight": 4 },

  { "id": "D_TERM_T_LIBRARY", "slot": "TERM", "text": "图书馆管理员下班前会跟你说：明天见。", "when": { "talentsAny": ["T_LIBRARY"] }, "weight": 5 },
  { "id": "D_TERM_T_DEADLINE", "slot": "TERM", "text": "论文在截止前三小时动笔，交上去前一分钟写完了参考文献。", "when": { "talentsAny": ["T_DEADLINE"] }, "weight": 5 },
  { "id": "D_TERM_T_DRIVER", "slot": "TERM", "text": "全宿舍只有你会开车，你成了大家去 Costco 的专职司机。", "when": { "talentsAny": ["T_DRIVER"] }, "weight": 5 },
  { "id": "D_TERM_T_ROOMMATE", "slot": "TERM", "text": "室友半夜给你留了一碗热汤面，还贴了张便利贴。", "when": { "talentsAny": ["T_ROOMMATE"] }, "weight": 5 },
  { "id": "D_TERM_T_HOTPOT", "slot": "TERM", "text": "你组的火锅局又满员了，锅底是从国内背来的。", "when": { "talentsAny": ["T_HOTPOT"] }, "weight": 5 },
  { "id": "D_TERM_T_LAOGANMA", "slot": "TERM", "text": "你的老干妈只剩最后半瓶，你开始按勺分配。", "when": { "talentsAny": ["T_LAOGANMA"] }, "weight": 5 },
  { "id": "D_TERM_T_RICE_COOKER", "slot": "TERM", "text": "你的电饭煲成了整层楼的公共财产，用之前要提前预约。", "when": { "talentsAny": ["T_RICE_COOKER"] }, "weight": 5 },
  { "id": "D_TERM_T_COUPON", "slot": "TERM", "text": "你叠了三张优惠券，超市倒找了你几美分。", "when": { "talentsAny": ["T_COUPON"] }, "weight": 5 },
  { "id": "D_TERM_T_GPA_HUNTER", "slot": "TERM", "text": "你给每门课都算好了拿 A 需要的最低分，精确到小数点后一位。", "when": { "talentsAny": ["T_GPA_HUNTER"] }, "weight": 5 },
  { "id": "D_TERM_T_GOOD_LOOKING", "slot": "TERM", "text": "你在食堂排队时被人要了联系方式，对方说是想问作业。", "when": { "talentsAny": ["T_GOOD_LOOKING"] }, "weight": 5 },
  { "id": "D_TERM_T_NET_SENSE", "slot": "TERM", "text": "你随手发的留学日常小视频，播放量比你的期中成绩还高。", "when": { "talentsAny": ["T_NET_SENSE"] }, "weight": 5 },
  { "id": "D_TERM_T_MILK_TEA", "slot": "TERM", "text": "奶茶店店员看到你进门，已经开始做你常点的那杯。", "when": { "talentsAny": ["T_MILK_TEA"] }, "weight": 5 },
  { "id": "D_TERM_T_NIGHT_OWL", "slot": "TERM", "text": "你的作息和国内同步了，白天的课全靠意志力。", "when": { "talentsAny": ["T_NIGHT_OWL"] }, "weight": 5 },
  { "id": "D_TERM_T_SOCIAL_ANXIETY", "slot": "TERM", "text": "为了不在电梯里遇到人，你每天爬六层楼梯。", "when": { "talentsAny": ["T_SOCIAL_ANXIETY"] }, "weight": 5 },
  { "id": "D_TERM_T_PROCRASTINATE", "slot": "TERM", "text": "你把期末复习计划做得非常精美，然后去打扫了宿舍。", "when": { "talentsAny": ["T_PROCRASTINATE"] }, "weight": 5 },
  { "id": "D_TERM_T_SPENDTHRIFT", "slot": "TERM", "text": "购物网站的推荐页比你还懂你，这个月又月光了。", "when": { "talentsAny": ["T_SPENDTHRIFT"] }, "weight": 5 },
  { "id": "D_TERM_T_JUANWANG", "slot": "TERM", "text": "你给自己的周末排了课表，休息被安排在周日晚上十点。", "when": { "talentsAny": ["T_JUANWANG"] }, "weight": 5 },
  { "id": "D_TERM_T_SECONDHAND", "slot": "TERM", "text": "你把上学期的课本、台灯和半袋大米都挂上了二手群。", "when": { "talentsAny": ["T_SECONDHAND"] }, "weight": 5 },
  { "id": "D_TERM_T_NAP_MASTER", "slot": "TERM", "text": "你能在任何一节课的任何五分钟里睡着，醒来还能接上话。", "when": { "talentsAny": ["T_NAP_MASTER"] }, "weight": 5 },
  { "id": "D_TERM_T_HOMESICK", "slot": "TERM", "text": "你把家乡的天气预报加进了手机，每天看两遍。", "when": { "talentsAny": ["T_HOMESICK"] }, "weight": 5 },
  { "id": "D_TERM_T_SYSTEM", "slot": "TERM", "text": "脑海里响起一声“叮”：今日任务——按时交作业。", "when": { "talentsAny": ["T_SYSTEM"] }, "weight": 5 },
  { "id": "D_TERM_T_REBORN", "slot": "TERM", "text": "这堂课你总觉得上过一遍，连教授的冷笑话都能提前接上。", "when": { "talentsAny": ["T_REBORN"] }, "weight": 5 },
  { "id": "D_TERM_T_GOLD_MINE", "slot": "TERM", "text": "家里打来生活费时多按了一个零，你犹豫了一下要不要说。", "when": { "talentsAny": ["T_GOLD_MINE"] }, "weight": 5 },
  { "id": "D_TERM_T_LEETCODE", "slot": "TERM", "text": "你刷题的提交记录比朋友圈还勤，日历上连成了一片绿。", "when": { "talentsAny": ["T_LEETCODE"] }, "weight": 5 },
  { "id": "D_TERM_T_THICK_SKIN", "slot": "TERM", "text": "你在招聘会上把同一个展位逛了三遍，招聘官记住了你。", "when": { "talentsAny": ["T_THICK_SKIN"] }, "weight": 5 },
  { "id": "D_TERM_T_FELLOW_TOWNSMEN", "slot": "TERM", "text": "你在学校找到了十几个老乡，每周聚一次吃家乡菜。", "when": { "talentsAny": ["T_FELLOW_TOWNSMEN"] }, "weight": 5 },
  { "id": "D_TERM_T_EARLY_BIRD", "slot": "TERM", "text": "你每天早上六点起床，整栋楼只有你和松鼠醒着。", "when": { "talentsAny": ["T_EARLY_BIRD"] }, "weight": 5 },

  { "id": "D_FALL_HALLOWEEN", "slot": "FALL", "text": "万圣节你没有准备服装，室友说你本色出演。", "when": {}, "weight": 2 },
  { "id": "D_FALL_HALLOWEEN_CANDY", "slot": "FALL", "text": "万圣节你买了一大袋糖准备发，一个敲门的都没来，自己吃到了感恩节。", "when": {}, "weight": 2 },
  { "id": "D_FALL_THANKSGIVING_HOST", "slot": "FALL", "text": "感恩节本地同学请你回家吃火鸡，你吃完才知道还有第二轮。", "when": {}, "weight": 2 },
  { "id": "D_FALL_THANKSGIVING_EMPTY", "slot": "FALL", "text": "感恩节整个校园空了，你和留下的几个人在宿舍煮了火锅。", "when": {}, "weight": 2 },
  { "id": "D_FALL_BLACK_FRIDAY", "slot": "FALL", "text": "黑五你熬夜抢了一台打折的显示器，到货发现宿舍放不下。", "when": {}, "weight": 2 },
  { "id": "D_FALL_FOOTBALL", "slot": "FALL", "text": "你第一次去看橄榄球赛，跟着全场站起来坐下，规则一条没懂。", "when": {}, "weight": 2 },
  { "id": "D_FALL_TAILGATE", "slot": "FALL", "text": "比赛日校园里全是烤肉的烟，你蹭了三个陌生人的汉堡。", "when": {}, "weight": 2 },
  { "id": "D_FALL_MIDTERM_SEAT", "slot": "FALL", "text": "期中周图书馆一座难求，你在楼梯间找到了一个插座。", "when": {}, "weight": 2 },
  { "id": "D_FALL_COURSE_REG", "slot": "FALL", "text": "选课那天你定了三个闹钟，抢到的课在早上八点。", "when": {}, "weight": 2 },
  { "id": "D_FALL_MOONCAKE", "slot": "FALL", "text": "中秋节学生会发了月饼，你分到一块五仁的。", "when": {}, "weight": 2 },
  { "id": "D_FALL_GOLDEN_WEEK", "slot": "FALL", "text": "国庆长假国内朋友在晒人山人海，你在上课。", "when": {}, "weight": 2 },
  { "id": "D_FALL_DST", "slot": "FALL", "text": "冬令时开始，下午四点半天就黑了，你以为自己睡过了头。", "when": {}, "weight": 2 },
  { "id": "D_FALL_LEAVES", "slot": "FALL", "text": "满校园的红叶，你拍了一组照片，配文是“又是想家的一天”。", "when": {}, "weight": 2 },
  { "id": "D_FALL_APPLE_PICKING", "slot": "FALL", "text": "周末跟同学去果园摘苹果，摘的没有吃的多。", "when": {}, "weight": 2 },
  { "id": "D_FALL_BLACK_FRIDAY_RICH", "slot": "FALL", "text": "黑五你买了一堆东西，快递盒在门口堆成了一堵墙。", "when": { "economies": ["HIGH"] }, "weight": 4 },
  { "id": "D_FALL_BLACK_FRIDAY_BROKE", "slot": "FALL", "text": "黑五你在购物车里加满了东西，最后只结账了一包袜子。", "when": { "statMax": { "money": 25 } }, "weight": 4 },
  { "id": "D_FALL_FIRST_SNOW", "slot": "FALL", "text": "第一场雪落下来，你在雪地里拍了二十张照片发给家里。", "when": { "schoolStates": ["MA", "NY", "PA", "IL", "MI", "MN", "WI", "OH", "IN", "IA", "CT", "RI", "NH", "VT", "ME", "NJ", "CO", "UT", "NE", "KS", "MO", "ID", "WY"] }, "weight": 4 },
  { "id": "D_FALL_NO_SNOW", "slot": "FALL", "text": "国内的朋友在晒初雪，你穿着短袖在棕榈树下点了个赞。", "when": { "schoolStates": ["FL", "TX", "AZ", "HI", "LA"] }, "weight": 4 },
  { "id": "D_FALL_ORIENTATION", "slot": "FALL", "text": "新生周你参加了七场破冰活动，记住了零个名字。", "when": { "stage": "UG", "termMax": 1 }, "weight": 5 },
  { "id": "D_FALL_FIRST_MONTH", "slot": "FALL", "text": "开学第一个月，你每天和家里视频，比高中时还勤。", "when": { "stage": "UG", "termMax": 1 }, "weight": 4 },
  { "id": "D_FALL_SENIOR_APPS", "slot": "FALL", "text": "大四上，你在申请研究生和投简历之间反复横跳。", "when": { "stage": "UG", "termMin": 7 }, "weight": 4 },
  { "id": "D_FALL_MS_FIRST", "slot": "FALL", "text": "硕士开学第一周，同学已经在讨论明年夏天的实习了。", "when": { "stage": "MS", "termMax": 1 }, "weight": 4 },
  { "id": "D_FALL_INFO_SESSIONS", "slot": "FALL", "text": "秋招开始了，你一周参加了四场宣讲会，吃了四顿免费披萨。", "when": { "focusAny": ["CAREER"] }, "weight": 4 },
  { "id": "D_FALL_MIDTERM_EMO", "slot": "FALL", "text": "期中周连着三个通宵，你对着镜子认不出自己的黑眼圈。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_FALL_TX_HEAT", "slot": "FALL", "text": "德州的夏天一直延续到十月，你的空调比你还累。", "when": { "schoolStates": ["TX"] }, "weight": 5 },
  { "id": "D_FALL_CA_PUMPKIN", "slot": "FALL", "text": "加州没有秋天，你只能靠星巴克的南瓜拿铁确认季节。", "when": { "schoolStates": ["CA"] }, "weight": 5 },
  { "id": "D_FALL_FL_HURRICANE", "slot": "FALL", "text": "飓风预警发了三次，你囤的矿泉水够喝到明年。", "when": { "schoolStates": ["FL", "LA"] }, "weight": 5 },
  { "id": "D_FALL_CORN_TOUR", "slot": "FALL", "text": "你给国内的朋友视频介绍学校，镜头转了一圈，全是玉米。", "when": { "schoolStates": ["IA", "IN", "NE", "KS", "OH", "MO"] }, "weight": 5 },

  { "id": "D_SPRING_BREAK", "slot": "SPRING", "text": "春假同学都去了海边，你在朋友圈里看完了全程。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_ROAD_TRIP", "slot": "SPRING", "text": "春假你和朋友自驾去看大峡谷，在车上睡了三晚。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_VALENTINE", "slot": "SPRING", "text": "情人节你收到了一张卡片，是银行寄来的信用卡广告。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_CNY_GALA", "slot": "SPRING", "text": "除夕那天上午，你在图书馆用手机看春晚，倒计时前一秒卡住了。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_DUMPLINGS", "slot": "SPRING", "text": "春节学生会包饺子，你包的几个下锅就散成了片儿汤。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_RED_PACKET", "slot": "SPRING", "text": "大年初一你在群里抢红包，换成美元不够买一杯咖啡。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_SUPER_BOWL", "slot": "SPRING", "text": "超级碗那天你被拉去看球，全程只看懂了中场表演。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_ENERGY_DRINKS", "slot": "SPRING", "text": "期末周你喝完的能量饮料罐，在桌上搭成了一座塔。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_SCREAM", "slot": "SPRING", "text": "期末周的半夜，整栋宿舍楼一起对着窗外尖叫解压。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_POLLEN", "slot": "SPRING", "text": "春天来了，花粉也来了，你第一次知道自己过敏。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_TAXES", "slot": "SPRING", "text": "四月你第一次报税，填完表才发现自己根本没有收入。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_SUMMER_ASK", "slot": "SPRING", "text": "离放暑假还有一个月，家里已经问了三次回不回国。", "when": {}, "weight": 2 },
  { "id": "D_SPRING_BREAK_RICH", "slot": "SPRING", "text": "春假你飞去迈阿密晒了一周，回来黑了两个色号。", "when": { "economies": ["HIGH"] }, "weight": 4 },
  { "id": "D_SPRING_VALENTINE_LOOKS", "slot": "SPRING", "text": "情人节你的宿舍门缝里塞进了三张匿名卡片。", "when": { "talentsAny": ["T_GOOD_LOOKING"] }, "weight": 5 },
  { "id": "D_SPRING_CAP_TOSS", "slot": "SPRING", "text": "毕业典礼上你把学士帽抛得太高，落下来砸到了前排。", "when": { "stage": "UG", "termMin": 8 }, "weight": 5 },
  { "id": "D_SPRING_GRAD_PHOTOS", "slot": "SPRING", "text": "你穿着学位服在校园里拍了一整天照片，每张都是同一个姿势。", "when": { "stage": "UG", "termMin": 8 }, "weight": 5 },
  { "id": "D_SPRING_PARENTS_VISIT", "slot": "SPRING", "text": "爸妈飞过来参加毕业典礼，你当了一周导游兼翻译。", "when": { "stage": "UG", "termMin": 8 }, "weight": 4 },
  { "id": "D_SPRING_INTERN_FOLDERS", "slot": "SPRING", "text": "找暑期实习进入冲刺，你的邮箱分成了“面试”和“很遗憾”两个文件夹。", "when": { "stage": "UG", "termMax": 6, "focusAny": ["CAREER"] }, "weight": 4 },
  { "id": "D_SPRING_INTERN_SEASON", "slot": "SPRING", "text": "身边的人都在找暑期实习，你也打开了招聘网站，然后关上了。", "when": { "stage": "UG", "termMax": 6 }, "weight": 3 },
  { "id": "D_SPRING_ROOMMATE_TALKS", "slot": "SPRING", "text": "大一下要定明年的室友，你们宿舍连夜开了一场谈判。", "when": { "stage": "UG", "termMax": 2 }, "weight": 4 },
  { "id": "D_SPRING_MS_FOUND_YET", "slot": "SPRING", "text": "硕士的春天，大家见面第一句都是“找到了吗”。", "when": { "stage": "MS" }, "weight": 4 },
  { "id": "D_SPRING_NOT_BLOOMING", "slot": "SPRING", "text": "春天来了，花开了，你没有。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_SPRING_MARCH_SNOW", "slot": "SPRING", "text": "三月还在下雪，你的羽绒服已经穿出了包浆。", "when": { "schoolStates": ["MA", "NY", "PA", "IL", "MI", "MN", "WI", "OH", "IN", "IA", "CT", "RI", "NH", "VT", "ME", "NJ", "CO", "UT", "NE", "KS", "MO", "ID", "WY"] }, "weight": 4 },
  { "id": "D_SPRING_MA_WINTER", "slot": "SPRING", "text": "麻省的冬天太长，你在三月已经忘了草是绿色的。", "when": { "schoolStates": ["MA"] }, "weight": 5 },
  { "id": "D_SPRING_CHERRY", "slot": "SPRING", "text": "樱花开了，你在潮汐湖边挤了一下午，拍到的全是人头。", "when": { "schoolStates": ["DC", "VA", "MD"] }, "weight": 5 },
  { "id": "D_SPRING_SKI", "slot": "SPRING", "text": "宿舍窗外就是雪山，你租了雪板，摔了一整个周末。", "when": { "schoolStates": ["CO", "UT"] }, "weight": 5 },

  { "id": "D_WINTER_RELATIVES", "slot": "WINTER", "text": "寒假回国，被亲戚问了三遍以后能挣多少。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_PARTNER_Q", "slot": "WINTER", "text": "寒假回国，饭桌上被问有没有对象，你说在找了，在找工作。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_MISSED_CNY", "slot": "WINTER", "text": "寒假回国待了三周，返校那天离除夕还差十天。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_JET_LAG", "slot": "WINTER", "text": "倒时差倒了一周，你在凌晨四点的宿舍里吃完了一包薯片。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_JEANS", "slot": "WINTER", "text": "寒假回国吃胖了一圈，返校时牛仔裤给了你一个提醒。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_SNACKS", "slot": "WINTER", "text": "返校的行李箱一半是零食，海关问你带了什么，你说“snacks”。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_XMAS_ALONE", "slot": "WINTER", "text": "圣诞节你留在学校，整栋宿舍只剩你和一台自动售货机。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_XMAS_SOCKS", "slot": "WINTER", "text": "寒假住在同学家过圣诞，你收到了一双印着驯鹿的袜子。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_HOTPOT_MARATHON", "slot": "WINTER", "text": "寒假回国第一天，你连吃了三顿火锅，第四顿是烧烤。", "when": {}, "weight": 2 },
  { "id": "D_WINTER_NYE_TIMES_SQUARE", "slot": "WINTER", "text": "跨年夜你在时代广场挤了六个小时，零点时只看到前面的人头。", "when": { "schoolStates": ["NY", "NJ", "CT"] }, "weight": 5 },
  { "id": "D_WINTER_FROST", "slot": "WINTER", "text": "寒假留校，零下三十度的早晨，你的睫毛结了霜。", "when": { "schoolStates": ["MN", "WI", "MI", "IA", "NE", "ME", "VT", "NH"] }, "weight": 5 },
  { "id": "D_WINTER_SKI_RICH", "slot": "WINTER", "text": "寒假你去科罗拉多滑了一周雪，回来时腿还是软的。", "when": { "economies": ["HIGH"] }, "weight": 4 },
  { "id": "D_WINTER_DINING_SHIFT", "slot": "WINTER", "text": "寒假你留校在食堂帮工，跨年那天给自己加了个鸡腿。", "when": { "economies": ["LOW"] }, "weight": 4 },
  { "id": "D_WINTER_BROKE", "slot": "WINTER", "text": "寒假没回国，你把省下的机票钱在心里花了三遍。", "when": { "statMax": { "money": 20 } }, "weight": 4 },
  { "id": "D_WINTER_TIER_LOW", "slot": "WINTER", "text": "亲戚没听说过你的学校，你解释了十分钟，对方说“那也挺好”。", "when": { "schoolTiers": ["C", "D", "U"] }, "weight": 4 },
  { "id": "D_WINTER_TIER_S", "slot": "WINTER", "text": "亲戚在家族群里转发你学校的排名，配了三个大拇指。", "when": { "schoolTiers": ["S"] }, "weight": 4 },
  { "id": "D_WINTER_GPA_DODGE", "slot": "WINTER", "text": "寒假饭桌上，亲戚问你绩点多少，你说美国不兴这个。", "when": { "statMax": { "academics": 35 } }, "weight": 4 },
  { "id": "D_WINTER_GPA_PROUD", "slot": "WINTER", "text": "寒假饭桌上，你的绩点被爸妈当成了下酒菜。", "when": { "statMin": { "academics": 70 } }, "weight": 4 },
  { "id": "D_WINTER_TIRED", "slot": "WINTER", "text": "寒假你哪也没去，在宿舍里睡了一个月，还是觉得累。", "when": { "statMax": { "wellbeing": 25 } }, "weight": 4 },
  { "id": "D_WINTER_HOME_AIR", "slot": "WINTER", "text": "寒假回国，下飞机闻到熟悉的空气，你在出口站了好一会儿。", "when": { "aspirations": ["BELONGING"] }, "weight": 4 },
  { "id": "D_WINTER_TRAIN_ALONE", "slot": "WINTER", "text": "寒假你一个人坐火车横穿了半个美国，在车上看了三天雪原。", "when": { "aspirations": ["INDEPENDENCE"] }, "weight": 4 },
  { "id": "D_WINTER_SHORT_COURSE", "slot": "WINTER", "text": "寒假你报了一个冬季短课，学了一门和专业毫无关系的手艺。", "when": { "aspirations": ["DISCOVERY"] }, "weight": 4 },
  { "id": "D_WINTER_FIRST_BREAK", "slot": "WINTER", "text": "第一个寒假回国，家里人围着你，像看一件刚拆封的快递。", "when": { "stage": "UG", "termMax": 2 }, "weight": 4 },
  { "id": "D_WINTER_LAST_BREAK", "slot": "WINTER", "text": "最后一个寒假，亲戚的问题从“绩点多少”升级成了“找到工作没”。", "when": { "stage": "UG", "termMin": 8 }, "weight": 4 },
  { "id": "D_WINTER_MS_SHORT", "slot": "WINTER", "text": "读研的寒假很短，你回国一周，一半时间在倒时差。", "when": { "stage": "MS" }, "weight": 4 },
  { "id": "D_WINTER_T_HOMESICK", "slot": "WINTER", "text": "寒假回国前一周，你已经把行李收好放在门口了。", "when": { "talentsAny": ["T_HOMESICK"] }, "weight": 5 },
  { "id": "D_WINTER_T_LAOGANMA", "slot": "WINTER", "text": "返校时你的箱子里塞了十二瓶老干妈，排得像一排士兵。", "when": { "talentsAny": ["T_LAOGANMA"] }, "weight": 5 },
  { "id": "D_WINTER_T_COUPON", "slot": "WINTER", "text": "节后清仓你薅到了半价的圣诞装饰，打算明年再用。", "when": { "talentsAny": ["T_COUPON"] }, "weight": 5 }
]
